# Blank example only. Keep the populated alphalab.env file outside Git.
# Values must be JSON-quoted strings. Replace paths and credentials locally.
ALPHALAB_AGENT_MODE="local"
ALPHALAB_INSTANCE_ID="dev3"
ALPHALAB_RUNTIME_DIR="<absolute-private-runtime-directory>"
ALPHALAB_CACHE_DIR="<absolute-private-cache-directory>"
ALPHALAB_WEB_AUTH_ENABLED="1"
ALPHALAB_WEB_USERNAME=""
ALPHALAB_WEB_PASSWORD=""

# Optional remote-model network proxy. Configure it on the operator's machine.
ALPHALAB_MODEL_PROXY=""
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY="127.0.0.1,localhost,::1"
NODE_OPTIONS="--use-env-proxy"
ALPHALAB_WEB_SEARCH_PROVIDER=""
BRAVE_SEARCH_API_KEY=""

# Prefer the authenticated Model providers UI for the model key and selection.
# Keep any RQ/search credentials in the existing private instance configuration.
